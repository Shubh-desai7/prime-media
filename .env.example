# Copy to .env.local for local dev, and set the same names in Vercel > Project > Settings > Environment Variables.
# All three are public (NEXT_PUBLIC_*): they are shown on the site.

# POC's WhatsApp number: digits only, with country code. Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

NEXT_PUBLIC_CONTACT_EMAIL=primemedia@live.com
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
